 2 files changed, 273 insertions(+), 14 deletions(-)

diff --git a/include/asm-generic/rqspinlock.h b/include/asm-generic/rqspinlock.h
index 9bd11cb7acd60c..34c3dcb4299e84 100644
--- a/include/asm-generic/rqspinlock.h
